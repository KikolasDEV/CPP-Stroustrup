{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "cppbuild",
      "label": "C/C++: cl.exe (build en /build)",
      "command": "cl.exe",
      "args": [
        "/nologo",
        "/EHsc",
        "/Zi",
        "${file}",
        "/Fe${workspaceFolder}\\build\\${fileBasenameNoExtension}.exe",
        "/Fo${workspaceFolder}\\build\\",
        "/Fd${workspaceFolder}\\build\\"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$msCompile"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "detail": "Compila con MSVC y deja binarios/intermedios en build/."
    }
  ]
}
